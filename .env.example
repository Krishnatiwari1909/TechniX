# ==============================================================================
# AtmosAi Environment Configuration Template
# Copy this file to .env and insert your configuration parameters.
# ==============================================================================

# 1. Frontend API & WebSocket URLs (Optional - defaults to relative /api and localhost:8000)
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/telemetry

# 2. Supabase Configuration (Required for user authentication & cloud profile persistence)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key-here

# 3. Google Gemini API Key (For AI commute briefings and chat)
GEMINI_API_KEY=

# 4. Mapbox Directions API Key (Optional - for street routing; synthetic fallback used if empty)
VITE_MAPBOX_API_KEY=

# 5. Twilio SMS Credentials (Optional - for Emergency SMS SOS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# 6. Resend Email API Key (Optional - for Emergency Email SOS)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# 7. ElevenLabs API Key (Optional - for backend TTS)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# 8. Server & Network Configuration
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:5173
