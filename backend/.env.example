# ==========================================
# AtmosAi Backend Environment Configuration
# ==========================================

# 1. Supabase Backend Client (For secure profile verification)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key-here

# 2. Google Gemini API (For Contextual Early Warning Chatbot)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# 3. ElevenLabs API (Optional - for Emergency Voice Broadcast)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# 4. Twilio SMS Emergency Broadcast (Optional - for SMS SOS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# 5. Resend Email Emergency Broadcast (Optional - for Email SOS)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# 6. Server Configuration
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:5173
